// INGEGAR Platform — Prisma schema (Prisma 7, driver adapters)
// Multi-tenant ligero: cada recurso lleva tenantId. El rol "super" (INGEGAR) ve todo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  super
  supervisor
  client
  tecnico
}

enum AssetStatus {
  available
  in_use
  maintenance
  retired
}

enum AssignmentStatus {
  scheduled
  in_progress
  done
  cancelled
}

enum VehicleStatus {
  active
  maintenance
  retired
}

enum AssigneeRole {
  tecnico
  ayudante
}

enum ContractType {
  indefinido
  plazo_fijo
  ayudante
  no_renovado   // contrato no renovado al vencimiento
  despedido     // desvinculación por decisión de la empresa
}

enum DocType {
  contrato
  carnet
  epp
  altura
  antecedentes
  licencia
  otro
}

// Documentos a nivel empresa (reglamento, mutualidad, procedimiento interno) —
// no van por técnico ni por cliente, son tenant-wide. Mismo shape que
// TechnicianDocument a propósito (reutiliza el mismo patrón de subida a R2).
enum CompanyDocType {
  reglamento
  mutualidad
  procedimiento
  otro
}

model CompanyDocument {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       CompanyDocType @default(otro)
  label      String?
  fileUrl    String
  uploadedAt DateTime       @default(now())

  @@index([tenantId])
  @@map("company_documents")
}

// Bóveda de credenciales empresariales (informe #21) — solo `super`. Sin
// `responsables` por secreto (ACL granular): el propio gate de rol ya es el
// control de acceso, agregar una segunda capa de responsables por fila sería
// una abstracción sin necesidad real hoy (un solo tenant, pocos `super`).
model Secret {
  id          String   @id @default(cuid())
  tenantId    String
  serviceName String
  url         String?
  username    String?
  notes       String?
  // AES-256-GCM (node:crypto) — nunca texto plano. Formato "iv.authTag.data",
  // cada segmento base64. Ver src/lib/secrets/crypto.ts.
  ciphertext  String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User           @relation("SecretCreatedBy", fields: [createdById], references: [id])
  reveals   SecretReveal[]

  @@index([tenantId])
  @@map("secrets")
}

// Auditoría de "quién vio el secreto y cuándo" — nunca guarda el valor.
model SecretReveal {
  id         String   @id @default(cuid())
  secretId   String
  userId     String
  revealedAt DateTime @default(now())

  secret Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)
  user   User   @relation("SecretRevealedBy", fields: [userId], references: [id])

  @@index([secretId])
  @@map("secret_reveals")
}

// Auditoría transversal (informe #32B) — SOLO acciones sensibles con impacto
// real (operativo/documental/comercial/financiero/administrativo/seguridad/
// datos históricos), nunca navegación ni lecturas. Coexiste sin duplicar con
// TicketHistory (cambios de status de ticket), SecretReveal (quién vio qué
// secreto) y Job.legacyReviewedBy (triage legado) — cada uno sigue siendo la
// fuente correcta para SU evento específico; esto es para todo lo demás que
// no tenía ningún lugar central.
// `actorId` nullable a propósito (cron/sistema no tiene actor humano).
// `before`/`after` son JSON string de SOLO los campos que cambiaron — nunca
// un dump de la fila completa (así nunca puede colarse un passwordHash/
// ciphertext por accidente, el caller elige explícitamente qué campos loguear).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  actorRole  String
  action     String // ej: "user.create", "secret.update", "job.mark_paid"
  entityType String // ej: "User", "Secret", "Job", "ClientDocument"
  entityId   String
  before     String? // JSON, sanitizado por el caller
  after      String? // JSON, sanitizado por el caller
  reason     String?
  source     String // ej: "recursos/clientes/actions.ts:createPortalUser"
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

enum ExpenseCategory {
  combustible
  estacionamiento
  materiales
  viatico
  herramienta
  otro
}

enum ExpenseStatus {
  pendiente
  aprobado
  pagado
  rechazado
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  brandHex  String   @default("#f5b100")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  technicians   Technician[]
  assets        Asset[]
  vehicles      Vehicle[]
  assignments   Assignment[]
  clients       Client[]
  leaveRequests LeaveRequest[]
  payrolls      Payroll[]
  companyDocuments CompanyDocument[]
  secrets       Secret[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique // short alias for login (e.g. "ingegar", "justburger")
  name         String
  passwordHash String
  role         Role     @default(client)
  active       Boolean  @default(true)
  // Revocación de sesiones (G20): al incrementarse, los JWT emitidos con versión
  // menor quedan inválidos en el próximo auth() del lado Node.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clientId      String? // set when role = client, scopes portal access
  technicianId  String? @unique // set when role = tecnico
  branchId      String? // set when role = client AND scoped to one branch (branch users)
  isClientAdmin Boolean @default(false) // client admin (e.g. Carolina): can approve/reject tickets

  technician        Technician?       @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  ticketsCreated    Ticket[]          @relation("TicketCreatedBy")
  ticketsAssigned   Ticket[]          @relation("TicketAssignedTo")
  ticketHistory     TicketHistory[]
  ticketDocuments   TicketDocument[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  expensesApproved  Expense[]
  clientDocuments   ClientDocument[]
  signaturesCreated SignatureRequest[] @relation("SignatureCreatedBy")
  leaveApprovals    LeaveRequest[]     @relation("LeaveApprovals")
  secretsCreated    Secret[]           @relation("SecretCreatedBy")
  secretReveals     SecretReveal[]     @relation("SecretRevealedBy")
  auditLogs         AuditLog[]         @relation("AuditLogActor")
  jobLegacyReviews  Job[]              @relation("JobLegacyReviewedBy")
  jobInstallmentsCreated JobInstallment[] @relation("JobInstallmentCreatedBy")

  @@index([tenantId])
  @@map("users")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  type      String   // ticket_new | ticket_update | vehicle_alert | permission_approved
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([tenantId])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// --- Recursos: técnicos, cuadrillas, activos, asignaciones (cronograma) ---

model Technician {
  id        String   @id @default(cuid())
  name      String
  rut       String?
  specialty String? // especialidad / oficio (texto libre)
  email     String?
  phone     String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractType    ContractType @default(indefinido)
  contractEndDate DateTime?   // solo para plazo_fijo
  hireDate        DateTime?   // fecha de ingreso a la empresa
  baseSalary      Int?        // sueldo base mensual en CLP
  dailyRate       Int?        // CLP/día — para ayudantes eventuales
  birthDate       DateTime?
  address         String?
  phone2          String?     // segundo número de contacto
  mutualidad      String?     // organismo administrador: ACHS, IST, Mutual de Seguridad, etc.
  emergencyContact String?
  emergencyPhone  String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  user          User?    // back-relation: User.technicianId → this technician
  vehicle       Vehicle? // 1:1 — camioneta asignada (back-relation de Vehicle.technicianId)
  assignees     AssignmentAssignee[] // participaciones en asignaciones (técnico/ayudante)
  documents     TechnicianDocument[]
  ticketCollab  TicketCollaborator[]
  expenses      Expense[]
  signatures    SignatureRequest[]
  leaveRequests LeaveRequest[]
  payrolls      Payroll[]

  @@index([tenantId])
  @@unique([tenantId, rut])
  @@map("technicians")
}

model Vehicle {
  id        String        @id @default(cuid())
  plate     String // patente
  brand     String?
  model     String?
  year      Int?
  status    VehicleStatus @default(active)
  notes     String?

  // Vencimientos y mantenimiento
  revTecnicaExpiry         DateTime?
  soapExpiry               DateTime?
  permisoCirculacionExpiry DateTime?
  lastServiceDate          DateTime?
  nextServiceDate          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // 1:1 con técnico (un técnico, una camioneta).
  technicianId String?     @unique
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  assets Asset[] // herramientas en la camioneta (inventario)

  @@index([tenantId])
  @@unique([tenantId, plate])
  @@map("vehicles")
}

enum ClientLabel {
  principal
  ocasional
  prospecto
  inactivo
  proyecto
}

model Client {
  id           String       @id @default(cuid())
  name         String
  rut          String?
  contact      String?
  email        String?
  label        ClientLabel?
  portalSlug   String?      @unique
  portalTheme  String?
  driveFolderId String?
  logoUrl      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ruts        ClientRut[]
  assignments Assignment[]
  branches    Branch[]
  jobs        Job[]
  tickets     Ticket[]
  documents   ClientDocument[]

  @@index([tenantId])
  @@map("clients")
}

model ClientRut {
  id        String   @id @default(cuid())
  rut       String
  label     String?  // ej: "facturación", "casa matriz"
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_ruts")
}

model Asset {
  id        String      @id @default(cuid())
  name      String
  code      String?
  category  String?
  status    AssetStatus @default(available)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Camioneta a la que pertenece la herramienta (inventario por camioneta).
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([vehicleId])
  @@map("assets")
}

model Assignment {
  id                 String           @id @default(cuid())
  title              String
  description        String?
  start              DateTime
  end                DateTime
  status             AssignmentStatus @default(scheduled)
  permissionRequested Boolean         @default(false) // permiso de sucursal solicitado (verde/amarillo)
  meetingUrl         String? // enlace de reunión (Meet/Zoom), opcional
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  assignees AssignmentAssignee[] // técnicos y ayudantes
  expenses  Expense[]

  @@index([tenantId])
  @@index([start])
  @@index([ticketId])
  @@map("assignments")
}

model AssignmentAssignee {
  id           String       @id @default(cuid())
  role         AssigneeRole @default(tecnico)
  assignmentId String
  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician   @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, technicianId])
  @@index([technicianId])
  @@map("assignment_assignees")
}

// --- Flujo de Caja: sucursales, trabajos y costos ---

enum JobType {
  requerimiento
  emergencia
  preventivo
  proyecto
  otro
}

enum JobStatus {
  pendiente
  en_proceso
  ejecutado
  anulado
}

enum CollectionStatus {
  sin_oc
  pendiente_pago
  pagado
}

enum CostCategory {
  materiales
  mano_obra
  subcontrato
  transporte
  otros
}

// --- Flujo de Caja v2: pistas de estado en paralelo (ver
// docs/superpowers/specs/2026-07-24-flujo-caja-job-schema-design.md) ---

enum ProcessFlow {
  pre_quote // Flujo B: se cotiza antes de ejecutar
  post_execution // Flujo A: se ejecuta primero (emergencia), se valoriza después
}

// Estado de una OC en sí (informe #11) — ver Job.purchaseOrderStatus /
// JobInstallment.purchaseOrderStatus. Deliberadamente 2 valores, no más:
// "vigente" (default implícito cuando hay número de OC pero sin estado
// elegido) y "anulada" (el cliente la canceló/reemplazó) — no se modela
// "pendiente" acá porque ya lo cubre la ausencia de purchaseOrder.
enum PurchaseOrderStatus {
  vigente
  anulada
}

enum CommercialStage {
  intake
  quote_draft
  quote_sent
  valuation_pending // solo Flujo A: ejecutado, aún sin precio
  approved
  rejected
}

enum OperationalStage {
  pending
  scheduled
  in_progress
  executed
  client_review
  closed
}

enum DocumentationStage {
  pending
  partial
  ready
  sent
}

enum FinancialStage {
  no_po
  po_requested
  po_received
  to_invoice
  invoiced
  payment_pending
  overdue
  paid
}

model Branch {
  id           String   @id @default(cuid())
  tenantId     String
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name         String
  city         String?
  address      String? // dirección operativa de esta sucursal — una sola, no del cliente (Client no tiene dirección propia hoy)
  contactName  String? // responsable/contacto en terreno de esta sucursal específica
  contactPhone String?
  active       Boolean  @default(true)
  jobs      Job[]
  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, name])
  @@index([tenantId])
  @@index([clientId])
  @@map("branches")
}

model Job {
  id                String           @id @default(cuid())
  tenantId          String
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  branchId          String
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)

  costCenter        String?
  jobNumber         Int?
  importRef         String?          @unique
  quoteRef          String?
  hasTechReport     Boolean          @default(false)
  reportId          String?
  description       String
  type              JobType          @default(requerimiento)
  status            JobStatus        @default(ejecutado)
  executionDate     DateTime?
  technicianId      String?
  notes             String?
  extraNotes        String?

  currency          String           @default("CLP")
  netAmount         Int?
  taxAmount         Int?

  purchaseOrder     String?
  purchaseOrderFileUrl String? // R2 key — mismo patrón que Ticket.otFileUrl, reemplazo sobrescribe
  purchaseOrderDate DateTime?
  // Estado de la OC en sí (informe #11) — separado de financialStage/
  // collectionStatus (esos describen la etapa de cobranza del trabajo
  // completo, esto describe si ESTA orden de compra sigue siendo válida).
  // Nullable sin default: las OC históricas quedan sin estado (nunca se
  // infiere "vigente" a la fuerza) — ver hasPurchaseOrder() en job-presets.ts,
  // que trata null igual que antes de este campo existir.
  purchaseOrderStatus PurchaseOrderStatus?
  invoiceNumber     String?
  invoiceFileUrl    String? // R2 key — mismo patrón que Ticket.otFileUrl, reemplazo sobrescribe
  invoiceDate       DateTime?
  // Estado de la factura en sí (informe #13) — reusa el mismo enum que
  // purchaseOrderStatus (mismos 2 valores: vigente/anulada), no crea un tipo
  // paralelo solo por el nombre del campo. Nullable sin default, igual
  // criterio que la OC: histórico sin este campo nunca se infiere.
  invoiceStatus     PurchaseOrderStatus?
  creditDays        Int?
  paymentMethodRaw  String?
  collectionStatus  CollectionStatus @default(sin_oc)
  paymentDate       DateTime?
  // Pago parcial (informe #13) — hasta ahora Job solo soportaba pago binario
  // (markJobPaid/markJobPending). Nullable sin default: null = comportamiento
  // exacto de siempre (paymentDate solo = pagado total). JobInstallment ya
  // tenía su propio paymentAmount desde el informe #12 — este es el
  // equivalente para el trabajo de factura única (sin cuotas).
  paymentAmount     Int?

  originTicketId    String?
  originTicket      Ticket?          @relation("JobOrigins", fields: [originTicketId], references: [id], onDelete: SetNull)
  originProposalId  String?
  originProposal    ClientDocument?  @relation("JobFromProposal", fields: [originProposalId], references: [id], onDelete: SetNull)

  // Flujo de Caja v2 — pistas de estado en paralelo. status/collectionStatus
  // arriba se mantienen como derivados (ver src/lib/cashflow/derive-legacy-status.ts)
  // para no romper computeMetrics()/dashboard/flujo, que siguen leyéndolos tal cual.
  code               String?             @unique // YYMMDD-CLI-TT-NN | IMP-CLI-NNNN
  processFlow        ProcessFlow         @default(pre_quote)
  commercialStage    CommercialStage     @default(intake)
  operationalStage   OperationalStage    @default(pending)
  documentationStage DocumentationStage  @default(pending)
  financialStage     FinancialStage      @default(no_po)

  docOt              Boolean? // null = sin dato, no "no listo"
  docPhotos          Boolean?
  docReport          Boolean?
  docClientSent      Boolean?

  rejectionReason    String?
  rejectionDate      DateTime?

  nonBillable        Boolean             @default(false)
  nonBillableReason  String?

  lastContactDate    DateTime?
  nextContactDate    DateTime?
  contactNote        String?

  // Triage del backlog "modelo anterior" (2026-08-02, informe #9/#4): trabajos
  // reales del histórico que nunca tuvieron ticket y nunca lo tendrán (venían
  // de antes del sistema de tickets). true = revisado por un humano y
  // confirmado que no corresponde crear/vincular ticket — deja de contar como
  // pendiente en /conciliacion sin forzar una relación falsa. Nunca se setea
  // automáticamente.
  legacyNoTicket     Boolean             @default(false)
  // Quién marcó/desmarcó legado por última vez — no es el historial completo
  // del punto 28 (deferido, feature grande aparte), solo accountability
  // mínima para esta decisión puntual. `linkJobToExistingTicket` no se audita
  // acá a propósito: es mecánico y auto-evidente (el Job aparece en la ficha
  // del ticket), mismo criterio que ya aplica `linkJobToNewTicket` (tampoco
  // auditado). Marcar legado sí es un juicio humano que vale la pena atribuir.
  legacyReviewedById String?
  legacyReviewedBy   User?               @relation("JobLegacyReviewedBy", fields: [legacyReviewedById], references: [id], onDelete: SetNull)
  legacyReviewedAt   DateTime?

  // Cuotas (informe #12) — "Activar pago en cuotas" es solo fijar este
  // número; las cuotas en sí se crean de a una, cuando llega su OC (nunca
  // se fuerza crear las futuras). Los campos planos de arriba
  // (purchaseOrder/invoiceNumber/etc.) siguen siendo la fuente de verdad
  // para el 100% de los trabajos que NUNCA activan cuotas — no se tocan,
  // no se migran, se leen igual que siempre. Un trabajo con installments[]
  // no vacío usa esa tabla para su resumen financiero en vez de los campos
  // planos (ver src/lib/cashflow/job-presets.ts).
  installmentsPlanned Int?
  installments        JobInstallment[]

  costs             JobCost[]
  expenses          Expense[] // gastos de técnico atribuidos directamente a este trabajo (informe #14) — ver Expense.jobId
  ticket            Ticket?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([tenantId, clientId])
  @@index([branchId])
  @@index([originTicketId])
  @@index([originProposalId])
  @@index([code])
  @@index([processFlow, commercialStage])
  @@index([financialStage])
  @@map("jobs")
}

model TechnicianDocument {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  type         DocType    @default(otro)
  label        String?    // nombre personalizado del documento
  fileUrl      String     // R2 object key: technicians/[techId]/[timestamp]-[uuid].[ext]
  expiryDate   DateTime?  // vencimiento (ej. contrato plazo fijo, examen altura)
  notes        String?
  uploadedAt   DateTime   @default(now())

  @@index([technicianId])
  @@map("technician_documents")
}

// --- ClientOps: tickets de mantención por cliente ---

enum TicketUrgency {
  emergencia
  urgencia
  no_urgente
  preventivo
}

enum TicketStatus {
  pendiente_aprobacion // submitted by branch, awaiting client admin approval
  nuevo
  en_revision
  en_ejecucion
  esperando_aprobacion
  resuelto
  cancelado
  fusionado
}

enum ItemStatus {
  pendiente
  en_proceso
  resuelto
}

model Ticket {
  id             String        @id @default(cuid())
  ticketCode     String        @unique
  title          String
  description    String?
  urgency        TicketUrgency @default(no_urgente)
  category       String?
  status         TicketStatus  @default(nuevo)
  // Modalidad comercial (informe #2): PP (pre_quote) exige propuesta aprobada
  // antes de ejecutar; ED (post_execution) ejecuta primero y valoriza después.
  // Nullable sin default — los 142 tickets históricos no tenían esta decisión
  // y asignarles un valor a la fuerza sería inventar un dato que no existe.
  // Reusa el enum ProcessFlow que ya vive en Job (mismo concepto, ver
  // Job.processFlow) en vez de crear uno nuevo.
  processFlow    ProcessFlow?
  otNumber       String?
  otFileUrl      String? // R2 key: foto/escaneo de la orden de trabajo firmada
  estimatedDate  DateTime?
  closedDate     DateTime?
  workSummary    String?
  clientComment  String?
  internalNotes  String?
  folderKey      String?
  parentTicketId String?
  showToClient   Boolean       @default(true)
  tenantId       String
  clientId       String
  branchId       String?
  createdById    String
  assignedToId   String?
  jobId          String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  client        Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  branch        Branch?             @relation(fields: [branchId], references: [id])
  createdBy     User                @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo    User?               @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  job           Job?                @relation(fields: [jobId], references: [id])
  history       TicketHistory[]
  items         TicketItem[]
  documents     TicketDocument[]
  collaborators TicketCollaborator[]
  expenses      Expense[]
  assignments   Assignment[]
  originJobs    Job[]               @relation("JobOrigins")
  clientDocs    ClientDocument[]

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
  @@index([assignedToId])
  @@index([createdById])
  @@index([branchId])
  @@map("tickets")
}

model TicketHistory {
  id         String   @id @default(cuid())
  ticketId   String
  userId     String?
  fromStatus String?
  toStatus   String?
  note       String?
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@map("ticket_history")
}

model TicketItem {
  id          String     @id @default(cuid())
  ticketId    String
  title       String
  description String?
  status      ItemStatus @default(pendiente)
  order       Int        @default(0)
  createdAt   DateTime   @default(now())

  ticket      Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_items")
}

model TicketDocument {
  id           String   @id @default(cuid())
  ticketId     String
  uploadedById String?
  name         String
  fileUrl      String
  mimeType     String?
  uploadedAt   DateTime @default(now())

  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@map("ticket_documents")
}

model TicketCollaborator {
  id           String     @id @default(cuid())
  ticketId     String
  technicianId String

  ticket       Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technician   Technician @relation(fields: [technicianId], references: [id])

  @@unique([ticketId, technicianId])
  @@index([technicianId])
  @@map("ticket_collaborators")
}

// Gastos de terreno por técnico: combustible, estacionamiento, boletas, viáticos
model Expense {
  id            String          @id @default(cuid())
  tenantId      String
  technicianId  String
  ticketId      String?         // ticket asociado (opcional) — directo si está seteado
  // Trabajo específico de Flujo de Caja al que se atribuye este costo
  // (informe #14) — deliberadamente separado de ticketId: un ticket puede
  // tener varios Job, así que "directo" (ticketId) no basta para sumar el
  // gasto al margen de un trabajo puntual sin adivinar cuál. Nunca se
  // autoasigna — requiere una acción explícita (vincular/desvincular),
  // nunca inferencia por fecha/monto/nombre.
  jobId         String?
  assignmentId  String?         // asignación de cronograma asociada (opcional)
  category      ExpenseCategory @default(otro)
  amount        Int             // monto en CLP enteros
  description   String?
  supplier      String?         // proveedor (informe #14) — mismo campo que JobCost.supplier
  receiptUrl    String?         // URL o data URI del comprobante
  date          DateTime
  status        ExpenseStatus   @default(pendiente)
  approvedById  String?         // usuario que aprobó/rechazó
  rejectedReason String?
  paidAt        DateTime?       // cuándo se pagó/reembolsó al técnico (status=pagado)
  // Clasificación explícita SOLO relevante cuando ticketId es null (informe
  // #14): true = general confirmado (revisado y decidido que no es de un
  // ticket puntual); null = sin revisar — incluye el 100% del histórico
  // antes de este campo. Nunca se infiere "general" a la fuerza; cuando
  // ticketId está seteado la clasificación siempre es "directo" sin
  // depender de este campo (ver expenseClassification()).
  isGeneral     Boolean?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  technician  Technician   @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  assignment  Assignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  ticket      Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  approvedBy  User?        @relation(fields: [approvedById], references: [id])

  @@index([technicianId])
  @@index([tenantId, status])
  @@index([ticketId])
  @@index([jobId])
  @@index([assignmentId])
  @@map("expenses")
}

// --- Documentos de cliente: propuestas y informes técnicos guardados ---

enum ClientDocType {
  propuesta    // cotización/propuesta comercial
  informe      // informe técnico
  otro
}

enum ProposalStatus {
  borrador    // guardada, no enviada
  enviada     // enviada al cliente (email/WhatsApp)
  vista       // cliente confirmó que la vio
  aceptada    // cliente aceptó
  rechazada   // cliente rechazó
  perdida     // sin respuesta / descartada
}

model ClientDocument {
  id              String          @id @default(cuid())
  tenantId        String
  clientId        String
  type            ClientDocType   @default(otro)
  title           String
  fileKey         String          // R2 key, o "inline" cuando los datos están en dataJson
  dataJson        String?         // JSON completo del editor (QuoteData | ReportData) — fuente de verdad para re-editar
  metadata        String?         // JSON: { quoteId?, reportId?, amount?, version?, workOrder?, branch? } — ticketId YA NO vive aquí, ver campo `ticketId`
  ticketId        String?         // FK real (G2): reemplaza el antiguo metadata.ticketId por string-match
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  // Pipeline fields (solo para type = propuesta)
  proposalStatus  ProposalStatus?
  proposalAmount  Int?            // CLP bruto de la propuesta
  sentAt          DateTime?       // cuando se marcó como enviada
  viewedAt        DateTime?       // cuando el cliente la vio
  responseAt      DateTime?       // cuando respondió (aceptada/rechazada)
  followUpAt      DateTime?       // recordatorio de seguimiento
  proposalNote    String?         // notas comerciales internas

  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  ticket      Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  originJobs  Job[]           @relation("JobFromProposal")

  @@index([tenantId])
  @@index([clientId])
  @@index([ticketId])
  @@index([proposalStatus])
  @@map("client_documents")
}

// --- FES interna: firma electrónica simple para técnicos ---

enum SignatureStatus {
  pendiente
  firmado
  rechazado
}

model SignatureRequest {
  id            String          @id @default(cuid())
  tenantId      String
  technicianId  String
  documentType  String          // "contrato" | "anexo" | "acuerdo" | texto libre
  documentTitle String
  documentHash  String          // SHA-256 del contenido del documento
  documentData  String          // JSON con el contenido del documento
  status        SignatureStatus @default(pendiente)
  rutConfirmed  String?         // RUT que confirmó al firmar
  signedAt      DateTime?
  signedIp      String?
  rejectedAt    DateTime?
  rejectedNote  String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  technician    Technician      @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  createdBy     User?           @relation("SignatureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([technicianId])
  @@map("signature_requests")
}

model JobCost {
  id          String       @id @default(cuid())
  jobId       String
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  category    CostCategory @default(materiales)
  description String?
  amount      Int
  date        DateTime?
  supplier    String?
  documentRef String?
  createdAt   DateTime     @default(now())

  @@index([jobId])
  @@map("job_costs")
}

// Una cuota real (informe #12): su propia OC — nunca autogenerada, la emite
// el cliente — su propia factura (número SII manual) y su propio pago.
// Crear una NO exige haber creado las anteriores/futuras. Saldo de la cuota
// = netAmount - paymentAmount; saldo del trabajo = suma de saldos de sus
// cuotas (ver job-presets.ts).
model JobInstallment {
  id                   String    @id @default(cuid())
  jobId                String
  job                  Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sequence             Int
  netAmount            Int?
  purchaseOrder        String?
  purchaseOrderDate    DateTime?
  purchaseOrderFileUrl String?
  purchaseOrderStatus  PurchaseOrderStatus?
  invoiceNumber        String?
  invoiceDate          DateTime?
  invoiceFileUrl       String?
  invoiceStatus        PurchaseOrderStatus? // informe #13 — mismo enum que purchaseOrderStatus, ver Job.invoiceStatus
  creditDays           Int?
  paymentMethodRaw     String? // condiciones de pago de esta cuota (informe #11) — mismo campo que Job.paymentMethodRaw
  paymentDate          DateTime?
  paymentAmount        Int?
  notes                String?
  createdById          String
  createdBy            User      @relation("JobInstallmentCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([jobId])
  @@map("job_installments")
}

// ─── RR.HH. ────────────────────────────────────────────────────

enum LeaveType {
  vacaciones
  permiso_sin_goce
  permiso_con_goce
  licencia_medica
  otro
}

enum LeaveStatus {
  pendiente
  aprobado
  rechazado
}

model LeaveRequest {
  id           String      @id @default(cuid())
  tenantId     String
  technicianId String
  type         LeaveType   @default(vacaciones)
  startDate    DateTime
  endDate      DateTime
  days         Int
  status       LeaveStatus @default(pendiente)
  note         String?
  approvedById String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  technician  Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  approvedBy  User?      @relation("LeaveApprovals", fields: [approvedById], references: [id])

  @@index([tenantId])
  @@index([technicianId])
  @@map("leave_requests")
}

enum PayrollStatus {
  borrador
  emitido
  pagado
}

model Payroll {
  id           String        @id @default(cuid())
  tenantId     String
  technicianId String
  month        Int           // 1–12
  year         Int
  baseSalary   Int           // CLP bruto
  extras       Int           @default(0)   // horas extra, bonos
  deductions   Int           @default(0)   // descuentos
  note         String?
  status       PayrollStatus @default(borrador)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, month, year])
  @@index([tenantId])
  @@map("payrolls")
}
